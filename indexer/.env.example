# Filled from contracts/deployments/<chainId>.json after deployment (public addresses, not secrets).
# Envio Cloud requires the ENVIO_ prefix for variables used in config.yaml.
ENVIO_FACTORY_ADDRESS=
ENVIO_REGISTRY_ADDRESS=
ENVIO_START_BLOCK=0
# Optional, for HyperSync access from local runs: https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=
