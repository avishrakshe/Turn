# Copy to .env and fill in. NEVER commit .env or any real key.

# ---- Network ----
CHAIN_ID=10143                                # Monad testnet (mainnet: 143)
RPC_URL=https://testnet-rpc.monad.xyz

# ---- Contracts (@turn/contracts: ./contracts/script/deploy.sh) ----
DEPLOYER_PRIVATE_KEY=
AUSD_ADDRESS=                                 # empty on testnet -> MockAUSD (TEST ONLY); mainnet: 0x00000000eFE302BEAA2b3e6e1b18d08D69a9012a
OWNER=                                        # optional, defaults to the deployer
CRE_FORWARDER=                                # optional, defaults to the CRE simulation forwarder for the chain
MAX_CONTRIBUTION=                             # optional (6 decimals), default 25 AUSD on mainnet, 1000 elsewhere
MAX_MEMBERS=                                  # optional, default 10 on mainnet, 20 elsewhere

# ---- Relayer (@turn/relayer) ----
RELAYER_PRIVATE_KEY=
RELAYER_PORT=8787
MAX_GAS_PER_TX=1000000
DAILY_GAS_PER_ACCOUNT=5000000
RATE_LIMIT_PER_IP_PER_MIN=60
RATE_LIMIT_PER_ACCOUNT_PER_MIN=20
CORS_ORIGIN=*

# ---- Indexer (@turn/indexer, Envio) ----
ENVIO_API_TOKEN=
INDEXER_GRAPHQL_URL=

# ---- Automation (@turn/automation, Chainlink CRE) ----
CRE_ETH_PRIVATE_KEY=

# ---- Notifications ----
TELEGRAM_BOT_TOKEN=

# ---- Web app (@turn/web) — NEXT_PUBLIC_* values are exposed to the browser ----
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_CIRCLE_FACTORY_ADDRESS=
NEXT_PUBLIC_INDEXER_GRAPHQL_URL=
NEXT_PUBLIC_RELAYER_URL=
NEXT_PUBLIC_MERCURYO_WIDGET_ID=
MERCURYO_SECRET_KEY=
