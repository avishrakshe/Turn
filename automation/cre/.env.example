# Copy to automation/cre/.env (gitignored).
# Key that signs/broadcasts during `cre workflow simulate --broadcast` (needs a little testnet MON). No 0x prefix.
CRE_ETH_PRIVATE_KEY=
# From @BotFather. Mapped to secret id TELEGRAM_BOT_TOKEN in secrets.yaml. Any placeholder works while
# telegramChatId in the workflow config is empty (notifications off).
CRE_TELEGRAM_BOT_TOKEN=
